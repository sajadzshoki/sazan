# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=sazan

# Admin authentication. Required to sign in to /admin.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
ADMIN_SESSION_SECRET=change-this-long-random-secret
ADMIN_SESSION_MAX_AGE_SECONDS=28800

# Phase 4 notification webhook. Optional: when omitted, submissions use a safe development log fallback.
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_TOKEN=
NOTIFICATION_WEBHOOK_PROVIDER_NAME=webhook

# Public website URL and contact details shown on the contact page.
NUXT_PUBLIC_SITE_URL=https://sazan.studio
NUXT_PUBLIC_CONTACT_EMAIL=hello@sazan.studio
NUXT_PUBLIC_CONTACT_WHATSAPP=
NUXT_PUBLIC_CONTACT_TELEGRAM=
NUXT_PUBLIC_CONTACT_PHONE=
NUXT_PUBLIC_SOCIAL_LINKEDIN=
NUXT_PUBLIC_SOCIAL_BEHANCE=
NUXT_PUBLIC_SOCIAL_DRIBBBLE=

# Media storage. Local uploads are used in development; MinIO variables stay server-only for future storage.
STORAGE_PROVIDER=local
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=sazan-media
